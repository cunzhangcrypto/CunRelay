# ─── AI ───────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ─── Telegram 发布 ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-channel-id

# ─── X (Twitter) 发布：OAuth 1.0a 四件套 ───────────────────────
X_API_KEY=your-x-api-key
X_API_KEY_SECRET=your-x-api-key-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret

# ─── Google Sheets 发布日志 ───────────────────────────────────
# 服务账号 JSON 内容（单行），或留空使用 config/credentials.json
# 表格 ID 已默认写在 config/config.yaml（sheets.spreadsheet_id），
# 如需覆盖可设置 GOOGLE_SHEETS_ID（但 config.yaml 当前为字面值，无 ${} 引用）
GOOGLE_SHEETS_CREDENTIALS=

# ─── 可选：关注列表（JSON，优先级高于 config.yaml）─────────────
# FOLLOW_CONFIG={"youtube":[{"name":"Web3村长","channel_id":"UC5MbekhrH8iyFBQLbccBSRg"}]}
